#!/bin/sh
# Blocks direct commits to main, and em or en dashes in catalogs and web files people read.
# run.bat turns this on (core.hooksPath is local config, so it doesn't travel with a clone).

if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "main" ]; then
    echo "Refusing to commit directly to main. Use a branch." >&2
    exit 1
fi

em_dash=$(printf '\342\200\224')
en_dash=$(printf '\342\200\223')
marker=$(mktemp)
rm -f "$marker"
trap 'rm -f "$marker"' EXIT

git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
    case "$f" in
        internal/lang/catalogs/*|internal/app/web/*)
            git show ":$f" 2>/dev/null | grep -n -F -e "$em_dash" -e "$en_dash" | while IFS=: read -r line text; do
                echo "$f:$line: $text" >&2
                : > "$marker"
            done
            ;;
    esac
done

if [ -e "$marker" ]; then
    echo "Use a comma, colon, full stop or parentheses instead." >&2
    exit 1
fi
